ADSS_BASE_URL=https://ai-scope.cbpf.br
# JSONL monitor samples used by the Status page when running ./dev.sh.
MONITOR_HISTORY_PATH=/home/schwarz/arandu/data/monitor-history.jsonl
# Read-only ADSS account used to obtain a fresh token for each daily cache refresh.
ADSS_SERVICE_USERNAME=
ADSS_SERVICE_PASSWORD=
# Number of completed/current days refreshed by the server each UTC day.
CALENDAR_CACHE_LOOKBACK_DAYS=370
# false for a local HTTP host; set true after TLS terminates in front of Nginx.
COOKIE_SECURE=false
# Used only if the API is accessed directly while developing.
CORS_ORIGINS=http://localhost:5173
